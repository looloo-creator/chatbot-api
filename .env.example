# Server Configuration
PORT=3001
NODE_ENV=development

# Must match looloo-api's JWT_SECRET_KEY so signed-in users can access chat.
JWT_SECRET_KEY=replace-with-the-same-secret-used-by-looloo-api

# Allowed browser origins for direct local development.
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:18080

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text produces 768-dimensional vectors; must match the pgvector schema.

# PostgreSQL Configuration (use the same database settings as looloo-api)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=looloo
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
PG_CONNECT_TIMEOUT=15000

# API Configuration
LOOLOO_API_URL=http://localhost:3000
